{
  "expo": {
    "name": "Operax",
    "slug": "operax",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "operax",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "digital.operax.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ],
        "NSPhotoLibraryUsageDescription": "O Operax precisa acessar suas fotos para enviar imagens no atendimento.",
        "NSCameraUsageDescription": "O Operax usa a câmera para capturar fotos e vídeos do atendimento e para ler o código de barras dos produtos na venda.",
        "NSMicrophoneUsageDescription": "O Operax precisa do microfone para gravar áudios do atendimento quando disponível.",
        "NSPhotoLibraryAddUsageDescription": "O Operax salva na sua galeria as imagens que você pedir, como o resumo de um treino para compartilhar.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "pt-BR"
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "digital.operax.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#050a14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050a14",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1e4ed8",
          "defaultChannel": "operax-default",
          "sounds": []
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "O Operax usa a câmera para capturar fotos e vídeos do atendimento e para ler o código de barras dos produtos na venda.",
          "recordAudioAndroid": false
        }
      ],
      "expo-document-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "O Operax usa o microfone para você gravar e mandar áudios no chat com a equipe.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Operax lê seus treinos do app Saúde (tipo, duração, distância e batimentos) para marcar como feitos na sua ficha e mostrar ao seu personal.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sharing",
      [
        "react-native-share",
        {
          "ios": ["instagram-stories", "instagram", "whatsapp"],
          "android": ["com.instagram.android", "com.whatsapp", "com.whatsapp.w4b"]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O Operax precisa acessar suas fotos para enviar imagens no atendimento.",
          "savePhotosPermission": "O Operax salva na sua galeria as imagens que você pedir, como o resumo de um treino para compartilhar.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Operax usa sua localização durante o treino para medir distância, ritmo, velocidade e altitude da corrida ou do pedal.",
          "locationAlwaysAndWhenInUsePermission": "O Operax usa sua localização durante o treino, mesmo com a tela apagada, para medir distância, ritmo e altitude.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysPermission": "O Operax usa sua localização durante o treino, mesmo com a tela apagada, para medir distância, ritmo e altitude.",
          "locationFullAccuracyPermission": "O Operax precisa da localização precisa durante o treino para medir a distância e desenhar o caminho certo.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "pt-BR",
              "en",
              "es"
            ],
            "android": [
              "pt-BR",
              "en",
              "es"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5dcb948b-9371-4830-8324-29ef9a87e4e3"
      },
      "privacyPolicyUrl": "https://operax.digital/privacidade-mobile",
      "supportUrl": "https://operax.digital/suporte",
      "marketingUrl": "https://operax.digital",
      "router": {}
    },
    "locales": {
      "pt": "./locales/ios/pt.json",
      "en": "./locales/ios/en.json",
      "es": "./locales/ios/es.json"
    },
    "owner": "operaxdigitals-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5dcb948b-9371-4830-8324-29ef9a87e4e3",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
